{
  "name": "pocketledger",
  "version": "0.1.0",
  "description": "A private, offline personal finance tracker that runs in your browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Syed Ali",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeexduaa/pocketledger.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
